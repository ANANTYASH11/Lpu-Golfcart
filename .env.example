# ==============================================================================
# UniCart Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Core Project Information
PROJECT_NAME="CampusRide - LPU Campus Transport Management"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite:///campusride.db"

# Authentication & Security
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Operational Dispatch & Live Staleness Thresholds
LIVE_STALENESS_THRESHOLD_SEC=300
CROWD_LOW_THRESHOLD=0.40
CROWD_MODERATE_THRESHOLD=0.80
MAX_ACTIVE_BOOKINGS_PER_STUDENT=1
NO_SHOW_TIMEOUT_SEC=300

# CORS Configuration
CORS_ORIGINS="*"
